# ==============================================================
# Rajaku Printing — Docker .env
# Copy ke `.env.docker` (di-load oleh docker-compose untuk service backend, frontend, worker)
# ==============================================================

# --- PostgreSQL (Docker internal) ---
POSTGRES_USER=rajaku
POSTGRES_PASSWORD=rajaku_dev
POSTGRES_DB=rajaku_printing
POSTGRES_PORT=5432

# --- Backend ENV ---
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000

# Backend DB Connection (using docker service name)
DB_HOST=postgres
DB_PORT=5432
DB_USER=rajaku
DB_PASSWORD=rajaku_dev
DB_NAME=rajaku_printing
DB_SSLMODE=disable

# CORS and Trust
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=

# Secrets
JWT_SECRET=change-me-please-min-32-chars-in-production
NOTIFICATION_WORKER_SECRET=change-me-min-32-chars-shared-with-worker
# Alamat notification-worker DARI DALAM container backend. Wajib nama service
# docker (`worker`), bukan localhost — localhost di dalam container backend
# menunjuk ke backend itu sendiri, sehingga halaman pairing WhatsApp selalu
# melaporkan "worker tidak bisa dihubungi".
NOTIFICATION_WORKER_URL=http://worker:9090

# --- Frontend ENV ---
NUXT_APP_ENV=development
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
NUXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# --- Worker ENV ---
INTERNAL_SECRET=change-me-min-32-chars-shared-with-worker
BACKEND_API_URL=http://backend:8080
