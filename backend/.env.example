# ==============================================================
# Rajaku Printing — Backend .env.example
# Copy ke `backend/.env` (git-ignored)
# Semua env yang wajib divalidasi fail-fast di internal/config
# ==============================================================

# --- HTTP server ---
APP_ENV=development          # development | staging | production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080         # URL API/backend (dipakai untuk invoice PDF download link)
APP_FRONTEND_URL=http://localhost:3000     # URL halaman Nuxt (invite, /lacak/:resi, WA link). Di prod single-domain, kosongkan → fallback ke APP_BASE_URL.

# --- Logging ---
LOG_LEVEL=debug              # trace | debug | info | warn | error

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=rajaku
DB_PASSWORD=rajaku_dev
DB_NAME=rajaku_printing
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# --- CORS (frontend origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Trusted reverse proxies (security) ---
# Comma-separated IP/CIDR list gin should trust when reading X-Forwarded-For
# to compute the caller's real IP (used by every rate limiter below).
# DEFAULT EMPTY on purpose: with no entries, gin ignores X-Forwarded-For
# entirely and uses the raw TCP connection address — the safe choice for
# local dev (no reverse proxy in front). Only set this when the API sits
# behind a KNOWN reverse proxy, e.g. `TRUSTED_PROXIES=127.0.0.1` for a
# single-VPS nginx setup terminating TLS in front of this API. NEVER set this
# to something internet-reachable (e.g. 0.0.0.0/0) — that lets any client
# spoof its IP and bypass rate limiting entirely.
#
# WAJIB DIISI DI PRODUCTION (APP_ENV=production) — startup gagal kalau kosong.
# Alasannya: di belakang nginx, kosong = ClientIP() selalu 127.0.0.1 untuk
# SEMUA pengunjung, jadi seluruh rate limit runtuh jadi satu bucket global
# (endpoint verify 0.2 rps berlaku untuk seluruh dunia, dan satu penyerang
# cukup mematikan semua endpoint publik). Kalau API memang terekspos langsung
# tanpa proxy, nyatakan eksplisit: `TRUSTED_PROXIES=none`.
TRUSTED_PROXIES=

# --- Rate limit (public endpoints) ---
RATE_LIMIT_PUBLIC_RPS=5
RATE_LIMIT_PUBLIC_BURST=10

# Dedicated (stricter) limiter for POST /lacak/:resi/verify — guest checkout
# ownership proof (resi + no. WA). Endpoint ini vektor brute-force nomor WA,
# jadi jauh lebih ketat daripada RATE_LIMIT_PUBLIC_* di atas.
RATE_LIMIT_GUEST_VERIFY_RPS=0.2
RATE_LIMIT_GUEST_VERIFY_BURST=3

# Dedicated (stricter) limiter for POST /auth/google/request-otp and
# POST /auth/google/complete — same brute-force shape as guest-verify above:
# both accept an arbitrary WhatsApp number from an unauthenticated POST body
# (request-otp bisa dipakai spam kode ke satu nomor; complete bisa dipakai
# brute-force kode OTP numerik pendek), jadi dapat bucket sendiri yang ketat.
RATE_LIMIT_OTP_RPS=0.2
RATE_LIMIT_OTP_BURST=3

# --- Auth / JWT ---
# JWT_SECRET WAJIB >= 32 karakter. Generate: `openssl rand -base64 48`
JWT_SECRET=change-me-please-min-32-chars-in-production
JWT_ACCESS_TTL=24h          # 24h untuk MVP; nanti pendekkan saat refresh token siap
JWT_ISSUER=rajaku-printing
# TTL token guest-checkout (scope=guest_order, POST /lacak/:resi/verify).
# Sengaja pendek — token ini cuma untuk sesi upload/approve desain sekali duduk,
# BUKAN sesi penuh 24h seperti JWT_ACCESS_TTL.
JWT_GUEST_ORDER_TTL=30m

# --- OAuth (Google) — opsional: kosongkan SEMUA 3 untuk mematikan login
# Google (server tetap jalan, endpoint /auth/google/* balas 503
# OAUTH_NOT_CONFIGURED). Kalau diisi, WAJIB ketiganya (fail-fast di startup
# kalau cuma sebagian yang diisi) — jangan isi cuma REDIRECT_URL saja seperti
# di bawah ini, itu dianggap config parsial dan bikin `make run` gagal start.
# Redirect URL harus persis sama dengan yang didaftarkan di Google Cloud
# Console > OAuth 2.0 Client > Authorized redirect URIs. Untuk localhost:
#   GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=

# --- OTP WhatsApp verification (Google OAuth registration) ---
# Nomor WA bukan rahasia (tercetak di struk POS), jadi kepemilikannya wajib
# dibuktikan lewat kode OTP dikirim ke WA sebelum akun Google dibuat/di-
# upgrade dari guest — lihat internal/auth/service/google_oauth_service.go.
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s
OTP_CODE_LENGTH=6           # minimum 6 — 4/5 digit ditolak saat startup (review keamanan)
# Batas lintas-handoff per nomor WA (review keamanan) — mencegah WA-bomb ke
# satu nomor lewat banyak handoff registrasi berbeda sekaligus.
OTP_MAX_PER_PHONE_HOUR=5
OTP_MAX_FAILED_PER_PHONE_HOUR=10

# --- Notification worker (Baileys, Node.js microservice) ---
NOTIFICATION_WORKER_URL=http://localhost:9090
# Shared secret buat worker → /internal/notifications/* (WAJIB >= 32 chars).
# Generate: `openssl rand -base64 48`
NOTIFICATION_WORKER_SECRET=change-me-min-32-chars-shared-with-worker
# Retry policy — batas attempt per job sebelum status jadi `dead`.
NOTIFICATION_MAX_ATTEMPTS=5
# Retry pertama setelah gagal; berikutnya exponential (initial * 2^n), cap 30m.
NOTIFICATION_INITIAL_BACKOFF=30s
# Jaring pengaman: job bertanda is_sensitive (mis. OTP WhatsApp) yang tidak
# kunjung sampai status terminal (sent/dead) lebih lama dari ini akan
# di-redact paksa (message dikosongkan) oleh sweep terjadwal — lihat review
# keamanan finding #3.
NOTIFICATION_SENSITIVE_MESSAGE_TTL=1h

# --- File storage (local disk, spec section 19) ---
# Relatif ke working dir, atau absolute. Dibuat otomatis kalau belum ada,
# fail-fast kalau tidak bisa ditulis.
STORAGE_LOCAL_ROOT=./storage

# --- Payment ---
# Max size upload bukti transfer (MB). Reverse proxy juga sebaiknya cap di sini.
PAYMENT_MAX_UPLOAD_MB=5

# --- Design ---
# Max size file desain (MB). CDR/AI bisa jauh lebih besar dari bukti transfer.
DESIGN_MAX_UPLOAD_MB=25

# --- CMS (§14) ---
# Max size upload gambar artikel (MB). Setelah upload, service re-encode ke WebP
# via HugoSmits86/nativewebp (pure Go). Reverse proxy juga sebaiknya cap di sini.
CMS_IMAGE_MAX_UPLOAD_MB=8

# --- Invoice (§12) ---
# Data toko yg tampil di header PDF invoice. Semua boleh kosong (fallback nama saja).
INVOICE_COMPANY_NAME=Rajaku Printing
INVOICE_COMPANY_ADDRESS=Jl. Contoh No. 1, Trenggalek, Jawa Timur
INVOICE_COMPANY_PHONE=0812-XXXX-XXXX
INVOICE_COMPANY_EMAIL=hello@rajaku-printing.example

# --- Retention file desain (§19) ---
# Blob file desain dihapus otomatis N hari setelah upload; record DB tetap ada
# untuk rekap. Job jalan in-process (robfig/cron) di backend, bukan cron VPS.
#
# PENTING: masa retensi RUNTIME dibaca dari tabel app_settings
# (`design_retention_days`, editable super admin di /admin/pengaturan).
# RETENTION_DEFAULT_DAYS di bawah cuma fallback kalau row setting-nya hilang.
RETENTION_JOB_ENABLED=true
RETENTION_DEFAULT_DAYS=30
# H-berapa reminder internal dikirim sebelum file dihapus.
RETENTION_REMINDER_DAYS=3
# Jadwal cron 5 field (waktu server). Sweep dini hari, reminder jam kerja.
RETENTION_SWEEP_CRON=0 3 * * *
RETENTION_REMINDER_CRON=0 9 * * *
# Maksimum file yang diproses per run (sisanya lanjut run berikutnya).
RETENTION_BATCH_LIMIT=200
RETENTION_JOB_TIMEOUT=15m

# Nomor WA ops/staff tujuan alert internal (reminder retensi §19).
# Format bebas (08xx / 62xx / +62xx) — dinormalisasi ke 62xxx saat startup.
# Kosongkan untuk mematikan alert internal.
NOTIFICATION_INTERNAL_PHONE=
