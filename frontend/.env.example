# ==============================================================
# Rajaku Printing — Frontend .env.example
# Copy ke `frontend/.env` (git-ignored).
# Semua base URL dibaca dari runtimeConfig (nuxt.config.ts), TIDAK BOLEH
# hardcode di komponen — lihat spec section 2.
# ==============================================================

# Public (dikirim ke client) — nama env harus prefix NUXT_PUBLIC_
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
NUXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Private (server-only, tidak dikirim ke client)
NUXT_APP_ENV=development
