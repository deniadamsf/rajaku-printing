# ==============================================================
# Rajaku Printing — Notification Worker (.env.example)
# Copy ke `services/notification-worker/.env` (git-ignored).
# ==============================================================

# Backend Go API — dari mana kita claim job & lapor sent/failed.
# Wajib bisa dihubungi dari mesin worker.
BACKEND_API_URL=http://localhost:8080

# Shared secret sesuai backend NOTIFICATION_WORKER_SECRET. Wajib SAMA.
# Dikirim di header X-Internal-Secret setiap request.
INTERNAL_SECRET=dev-shared-secret-please-rotate-in-prod-min32

# Polling interval — worker cek /internal/notifications/claim setiap N ms.
# Naikkan kalau volume kecil (hemat query DB); turunkan kalau butuh latency
# lebih rendah. 5000 = 5 detik (default aman).
POLL_INTERVAL_MS=5000

# Batch size per poll — berapa job di-claim sekaligus. Kecil supaya
# rate-limit Baileys aman (WA gampang banned kalau spam).
BATCH_SIZE=5

# Session dir — Baileys simpan credential + keys di sini. Persist antar restart
# supaya tidak perlu scan QR ulang. Pastikan writable & aman (bukan public).
SESSION_DIR=./session

# ==============================================================
# ANTI-BAN (§13 — Baileys tidak resmi, nomor bisa diblokir WhatsApp)
# Default di bawah sudah konservatif. Menaikkan kecepatan = menaikkan
# risiko nomor kena banned. Jangan diubah tanpa alasan.
# ==============================================================

# --- 1. Pacing: jeda ACAK antar pesan ---
# Jeda diacak dalam rentang [MIN, MAX] ms. Jeda konstan = tanda tangan bot.
MIN_SEND_INTERVAL_MS=3000
MAX_SEND_INTERVAL_MS=9000

# "Istirahat" berkala: setiap N pesan berturut-turut, worker berhenti selama
# jeda panjang yang juga diacak. 0 = matikan istirahat (tidak disarankan).
BURST_PAUSE_EVERY=8
BURST_PAUSE_MS=45000
BURST_PAUSE_MAX_MS=120000

# --- 2. Warmup nomor baru & cap harian ---
# Timezone acuan batas harian (cap reset lewat tengah malam waktu lokal).
TZ=Asia/Jakarta

# Ramp cap harian mengikuti umur sesi: hari ke-1 = 20 pesan, ke-2 = 40, dst.
# Setelah ramp habis, berlaku WA_DAILY_CAP. Kosongkan (WA_WARMUP_RAMP=) untuk
# mematikan warmup — TIDAK disarankan untuk nomor yang baru dipasang.
WA_WARMUP_RAMP=20,40,80,150,250
WA_DAILY_CAP=500

# File state cap/warmup (JSON). Harus persistent antar restart. Default:
# sebelah SESSION_DIR (./wa-state.json kalau SESSION_DIR=./session) — sengaja
# di luar session dir karena isinya dihapus saat logout WA.
# WA_STATE_FILE=./wa-state.json

# --- 3. Cap per penerima ---
# Maksimum pesan ke SATU nomor per hari + jeda minimum antar pesan ke nomor
# yang sama. Mencegah pelanggan dibanjiri lalu menekan Blokir/Laporkan —
# laporan penerima adalah sinyal ban terkuat.
WA_MAX_PER_RECIPIENT_DAY=5
WA_MIN_RECIPIENT_INTERVAL_MS=60000
# Kalau jeda di atas belum lewat, worker menunggu maksimal sekian ms; lebih
# dari itu job dilaporkan gagal supaya backend reschedule (antrian tidak macet).
WA_RECIPIENT_WAIT_MAX_MS=120000

# --- 4. Cek nomor terdaftar di WhatsApp (sock.onWhatsApp) ---
# Kirim ke nomor tanpa WhatsApp = sinyal spam kuat. Kalau tidak terdaftar,
# job dilaporkan gagal permanen (prefix "PERMANENT:") dan TIDAK dikirim.
WA_CHECK_REGISTERED=true
# TTL cache hasil pengecekan (ms). 86400000 = 24 jam.
WA_NUMBER_CACHE_TTL_MS=86400000

# --- 5. Simulasi mengetik (presence) ---
# presenceSubscribe → composing → jeda proporsional panjang pesan → paused.
WA_SIMULATE_TYPING=true
WA_TYPING_MS_PER_CHAR_MIN=40
WA_TYPING_MS_PER_CHAR_MAX=80
WA_TYPING_MIN_MS=1000
WA_TYPING_MAX_MS=4000

# --- 6. Circuit breaker ---
# Setelah N error "bahaya" berturut-turut (connection closed / rate-limit /
# 429-like), pengiriman dihentikan sementara dengan backoff eksponensial.
WA_CIRCUIT_FAILURE_THRESHOLD=3
WA_CIRCUIT_BASE_BACKOFF_MS=60000
WA_CIRCUIT_MAX_BACKOFF_MS=1800000

# HTTP port kecil untuk endpoint /healthz + /qr (menampilkan QR untuk pairing).
# Tidak boleh terekspos ke publik.
WORKER_PORT=9090

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
