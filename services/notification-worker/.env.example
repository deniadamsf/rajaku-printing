# ==============================================================
# Rajaku Printing — Notification Worker (.env.example)
# Copy ke `services/notification-worker/.env` (git-ignored).
# ==============================================================

# Backend Go API — dari mana kita claim job & lapor sent/failed.
# Wajib bisa dihubungi dari mesin worker.
BACKEND_API_URL=http://localhost:8080

# Shared secret sesuai backend NOTIFICATION_WORKER_SECRET. Wajib SAMA.
# Dikirim di header X-Internal-Secret setiap request.
INTERNAL_SECRET=dev-shared-secret-please-rotate-in-prod-min32

# Polling interval — worker cek /internal/notifications/claim setiap N ms.
# Naikkan kalau volume kecil (hemat query DB); turunkan kalau butuh latency
# lebih rendah. 5000 = 5 detik (default aman).
POLL_INTERVAL_MS=5000

# Batch size per poll — berapa job di-claim sekaligus. Kecil supaya
# rate-limit Baileys aman (WA gampang banned kalau spam).
BATCH_SIZE=5

# Rate limit — jeda MIN antar pesan WA (ms). 3000 = min 3 detik per pesan.
# Baileys tidak resmi (§13), pelan-pelan biar aman.
MIN_SEND_INTERVAL_MS=3000

# Session dir — Baileys simpan credential + keys di sini. Persist antar restart
# supaya tidak perlu scan QR ulang. Pastikan writable & aman (bukan public).
SESSION_DIR=./session

# HTTP port kecil untuk endpoint /healthz + /qr (menampilkan QR untuk pairing).
# Tidak boleh terekspos ke publik.
WORKER_PORT=9090

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
